retrieve get, create_session, destroy_session from Standard_Net;
retrieve print from Standard;

attempt {
    String s = create_session({});
    Map<Any> r = get('http://news.ycombinator.com', s);
    print("body: " + r['body']);
    print('headers: ' + r["headers"]);
    print("status: " + r['status']);
    Integer destroyed = destroy_session(s);
    if(destroyed) {
        print("Session " + s + " destroyed");
    } else {
        print("Session " + s + " not destroyed");
    }
} fix(e) {
    print("Oops: " + e);
}
